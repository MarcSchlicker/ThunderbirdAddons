<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zeitklar_background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/zeitklar_surface">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            style="@style/Widget.App.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/zeitklar_calendar_create_intro"
                android:textColor="@color/zeitklar_muted" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/zeitklar_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/zeitklar_line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/zeitklar_calendar_create_title_hint"
                        app:boxBackgroundColor="@color/zeitklar_surface"
                        app:boxStrokeColor="@color/zeitklar_accent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/zeitklar_calendar_event_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences"
                            android:maxLines="2"
                            android:textColor="@color/zeitklar_text"
                            android:textColorHint="@color/zeitklar_muted" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/TextAppearance.Material3.LabelLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/zeitklar_calendar_create_calendar"
                        android:textColor="@color/zeitklar_muted" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/zeitklar_calendar_event_calendar"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:gravity="start|center_vertical"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/zeitklar_calendar_create_pick_calendar"
                        android:textColor="@color/zeitklar_accent_strong"
                        app:strokeColor="@color/zeitklar_line" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/zeitklar_calendar_event_all_day"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/zeitklar_calendar_create_all_day"
                        android:textColor="@color/zeitklar_text" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/zeitklar_calendar_event_date"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:gravity="start|center_vertical"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:textColor="@color/zeitklar_accent_strong"
                        app:strokeColor="@color/zeitklar_line" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/zeitklar_calendar_event_end_date"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:gravity="start|center_vertical"
                        android:textColor="@color/zeitklar_accent_strong"
                        app:strokeColor="@color/zeitklar_line" />

                    <LinearLayout
                        android:id="@+id/zeitklar_calendar_event_time_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/zeitklar_calendar_event_start"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:textColor="@color/zeitklar_accent_strong"
                            app:strokeColor="@color/zeitklar_line" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/zeitklar_calendar_event_end"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:textColor="@color/zeitklar_accent_strong"
                            app:strokeColor="@color/zeitklar_line" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/zeitklar_calendar_event_repeat"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:gravity="start|center_vertical"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:textColor="@color/zeitklar_accent_strong"
                        app:strokeColor="@color/zeitklar_line" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/zeitklar_calendar_event_reminder"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:gravity="start|center_vertical"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:textColor="@color/zeitklar_accent_strong"
                        app:strokeColor="@color/zeitklar_line" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tb_connect_calendar_event_invitations"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="8dp"
                        android:gravity="start|center_vertical"
                        android:textColor="@color/zeitklar_accent_strong"
                        app:strokeColor="@color/zeitklar_line" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="@string/zeitklar_calendar_create_location_hint"
                        app:boxBackgroundColor="@color/zeitklar_surface"
                        app:boxStrokeColor="@color/zeitklar_line">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/zeitklar_calendar_event_location"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences"
                            android:maxLines="2"
                            android:textColor="@color/zeitklar_text"
                            android:textColorHint="@color/zeitklar_muted" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/zeitklar_calendar_event_save"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/zeitklar_calendar_create_save" />
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
